<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:polyxml:lexical-union" targetNamespace="urn:polyxml:lexical-union"
           elementFormDefault="qualified">
  <xs:simpleType name="NumberOrDay">
    <xs:union memberTypes="xs:int xs:gDay"/>
  </xs:simpleType>
  <xs:simpleType name="IntegerOrDate">
    <xs:union memberTypes="xs:int xs:date"/>
  </xs:simpleType>
  <xs:simpleType name="Code">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LATE"/>
      <xs:enumeration value="EARLY"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodeOrPattern">
    <xs:union memberTypes="t:Code">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Z]{3}[0-9]{2}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:complexType name="Payload">
    <xs:sequence>
      <xs:element name="number" type="t:NumberOrDay"/>
      <xs:element name="code" type="t:CodeOrPattern"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="payload" type="t:Payload"/>
  <xs:complexType name="DatedPayload">
    <xs:sequence>
      <xs:element name="dateValue" type="t:IntegerOrDate"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="datedPayload" type="t:DatedPayload"/>
</xs:schema>
