diff --git a/crates/polyxml-core/tests/test_runtime_fast_paths.rs b/crates/polyxml-core/tests/test_runtime_fast_paths.rs
index c0f13f1..35e1753 100644
--- a/crates/polyxml-core/tests/test_runtime_fast_paths.rs
+++ b/crates/polyxml-core/tests/test_runtime_fast_paths.rs
@@ -242,3 +242,28 @@ fn unified_scalar_state_keeps_mixed_branch_order_nil_and_nested_frames() {
     assert!(deserialize(nil_document, Arc::clone(&schema)).is_ok());
     assert!(deserialize(b"<Root><State>invalid</State></Root>", schema).is_err());
 }
+
+#[test]
+fn nested_mixed_frames_resolve_kind_from_their_parent_schema() {
+    use polyxml::schema_parser::XsdParser;
+    let ir = XsdParser::new().parse_str(r#"<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
+      <xs:element name="Root"><xs:complexType mixed="true"><xs:choice minOccurs="0" maxOccurs="unbounded">
+        <xs:element name="Lead" type="xs:string"/>
+        <xs:element name="Child"><xs:complexType mixed="true"><xs:choice minOccurs="0" maxOccurs="unbounded">
+          <xs:element name="Grand"><xs:complexType><xs:sequence><xs:element name="Value" type="xs:string"/></xs:sequence></xs:complexType></xs:element>
+          <xs:element name="Inner" type="xs:string"/>
+        </xs:choice></xs:complexType></xs:element>
+        <xs:element name="Tail" type="xs:int"/>
+      </xs:choice></xs:complexType></xs:element>
+    </xs:schema>"#).unwrap();
+    let schema = ModelSchema::from_ir(&ir, Some("Root")).unwrap();
+    let xml = b"<Root>before<Lead>lead</Lead><Child>start<Grand><Value>deep</Value></Grand><Inner>inner</Inner>end</Child><Tail>7</Tail>after</Root>";
+    let value = deserialize(xml, Arc::clone(&schema)).unwrap();
+    let output = serialize("Root", &value, &schema, None).unwrap();
+    assert_eq!(value, deserialize(&output, Arc::clone(&schema)).unwrap());
+    assert!(deserialize(
+        b"<Root><Child><Grand><Value>unfinished</Value></Grand>",
+        schema
+    )
+    .is_err());
+}
