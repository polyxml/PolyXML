<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Dictionary">
    <xs:complexType>
      <xs:sequence maxOccurs="unbounded">
        <xs:element name="key" type="xs:string"/>
        <xs:element name="value" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>