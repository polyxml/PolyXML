<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="BaseType">
    <xs:attribute name="baseAttr" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="ExtendedType">
    <xs:complexContent>
      <xs:extension base="BaseType">
        <xs:sequence><xs:element name="content" type="xs:string"/></xs:sequence>
        <xs:attribute name="extAttr" type="xs:string" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="Root" type="ExtendedType"/>
</xs:schema>