<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <xs:complexType name="Leaf"><xs:simpleContent><xs:extension base="Middle"><xs:attribute name="tag" type="xs:string"/></xs:extension></xs:simpleContent></xs:complexType>
 <xs:complexType name="Middle"><xs:simpleContent><xs:extension base="Base"><xs:attribute name="rank" type="xs:int" use="required"/></xs:extension></xs:simpleContent></xs:complexType>
 <xs:complexType name="Base"><xs:simpleContent><xs:extension base="xs:int"><xs:attribute name="unit" type="xs:string"/></xs:extension></xs:simpleContent></xs:complexType>
 <xs:simpleType name="Code"><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{2}"/></xs:restriction></xs:simpleType>
 <xs:complexType name="CodeBase"><xs:simpleContent><xs:extension base="Code"/></xs:simpleContent></xs:complexType>
 <xs:complexType name="CodeLeaf"><xs:simpleContent><xs:extension base="CodeBase"><xs:attribute name="label" type="xs:string"/></xs:extension></xs:simpleContent></xs:complexType>
 <xs:simpleType name="Number"><xs:restriction base="xs:int"><xs:minInclusive value="1"/></xs:restriction></xs:simpleType>
 <xs:complexType name="BoundedBase"><xs:simpleContent><xs:extension base="Number"/></xs:simpleContent></xs:complexType>
 <xs:complexType name="BoundedLeaf"><xs:simpleContent><xs:restriction base="BoundedBase"/></xs:simpleContent></xs:complexType>
 <xs:element name="Root" type="Leaf"/><xs:element name="CodeRoot" type="CodeLeaf"/><xs:element name="BoundedRoot" type="BoundedLeaf"/>
</xs:schema>
