<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:items" targetNamespace="urn:items" elementFormDefault="qualified">
  <xs:complexType name="ItemType"><xs:sequence>
    <xs:element name="Name" type="xs:string"/>
    <xs:element name="Quantity" type="xs:int"/>
  </xs:sequence><xs:attribute name="id" type="xs:int" use="required"/></xs:complexType>
  <xs:complexType name="BatchType"><xs:sequence>
    <xs:element name="Item" type="t:ItemType" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:element name="Batch" type="t:BatchType"/>
</xs:schema>
